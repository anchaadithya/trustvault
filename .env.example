# Copy to .env (never commit .env). For local dev only:
DJANGO_DEBUG=1
# Production: generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave blank for SQLite. For PostgreSQL set all of these:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
PRIVATE_STORAGE_ROOT=/var/lib/trustvault/private   # persistent, outside the code/static dirs
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
